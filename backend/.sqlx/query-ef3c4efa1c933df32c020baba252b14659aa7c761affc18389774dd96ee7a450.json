{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id AS \"id: _\", u.google_id, u.email, u.name, u.picture_url, u.created_at, u.updated_at\n        FROM users u\n        INNER JOIN sessions s ON u.id = s.user_id\n        WHERE s.token_hash = $1 AND s.expires_at > NOW()\n        ",
