#!/bin/bash
# pre-push hook: openapi.json / api.ts の同期チェック、frontend-leptos の clippy/test
# backend/src の変更があれば openapi.json と api.ts の更新漏れを、
# frontend-leptos の変更があれば clippy と test の失敗を検出する

set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)

# push 対象のコミットに含まれる変更ファイルを確認
# stdin から "local_ref local_sha remote_ref remote_sha" を読み取る
while read local_ref local_sha remote_ref remote_sha; do
  # 新規ブランチの場合は origin/main との差分
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    changed=$(git diff --name-only "origin/main...$local_sha" 2>/dev/null || true)
  else
    changed=$(git log --name-only --format="" "$remote_sha..$local_sha" 2>/dev/null || true)
  fi

  if echo "$changed" | grep -q "^backend/src/"; then
    bash "$REPO_ROOT/scripts/check-openapi.sh"
  fi

  if echo "$changed" | grep -q "^frontend-leptos/"; then
    (cd "$REPO_ROOT/frontend-leptos" && cargo clippy --target wasm32-unknown-unknown -- -D warnings)
    (cd "$REPO_ROOT/frontend-leptos" && cargo test)
  fi
done

exit 0
